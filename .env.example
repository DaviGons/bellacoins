# Copiar este arquivo para .env (na mesma pasta) e preencher. O .env não vai para o GitHub.

# Pix da loja (skill cobrar-pix). Preferir a chave aleatória: o cliente vê a chave no app do banco.
PIX_CHAVE=
# aleatoria, email, celular, cpf ou cnpj
PIX_TIPO=aleatoria
# Nome do titular como aparece no banco (até 25 letras; acentos são tirados)
PIX_NOME=
# Cidade do titular (até 15 letras)
PIX_CIDADE=
