# Copiar para .env.local e preencher. O .env.local não vai para o git.
# Sem nada preenchido, o site roda no modo demonstração (Pix de exemplo, painel aberto no computador).

# Pix da loja (conta separada da loja, com chave própria). Preencher desliga o modo demonstração.
# PIX_NOME: titular, até 25 letras, sem acento. PIX_CIDADE: até 15 letras, sem acento.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Senha do /painel (8 caracteres ou mais). Obrigatória fora do modo demonstração.
PAINEL_SENHA=

# Onde ficam os pedidos: "arquivo" (local, em .dados/pedidos.json). "supabase" ainda não foi ligado.
PEDIDOS_ARMAZENAMENTO=arquivo
# PEDIDOS_ARQUIVO=.dados/pedidos.json

# Para quando o Supabase for ligado (projeto bellacoins). A service_role nunca vai para o navegador.
# SUPABASE_URL=https://cyruigouzeigkjhzqdgv.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Business da loja, só números com 55 e DDD (ex.: 5511912345678).
# Usado no pagamento com cartão (abre a conversa com o pedido escrito) e nos links de contato.
# Vazio = o botão do cartão abre o WhatsApp pedindo para escolher o contato, e o rodapé mostra "em breve".
NEXT_PUBLIC_WHATSAPP_NUMERO=
