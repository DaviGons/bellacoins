# Copiar para .env.local e preencher. O .env.local não vai para o git.

# Pix da loja (conta separada da loja, com chave própria). Sem isso o pedido é criado, mas sem QR code.
# PIX_NOME: titular, até 25 letras, sem acento. PIX_CIDADE: até 15 letras, sem acento.
PIX_CHAVE=
PIX_NOME=
PIX_CIDADE=

# Senha do /painel (8 caracteres ou mais). Vazio = painel desligado.
PAINEL_SENHA=

# Onde ficam os pedidos: "arquivo" (local, em .dados/pedidos.json). Supabase vem depois.
PEDIDOS_ARMAZENAMENTO=arquivo
# PEDIDOS_ARQUIVO=.dados/pedidos.json

# Link do WhatsApp Business (ex.: https://wa.me/5511912345678). Vazio = não mostra.
NEXT_PUBLIC_WHATSAPP_URL=
